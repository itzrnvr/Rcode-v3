{
  "name": "rcode",
  "version": "0.1.0",
  "description": "Rcode — minimal, fast desktop AI coding assistant. Native, local-first, with persistent side chats and a Codex-inspired composer.",
  "license": "MIT",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.node.json && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start": "electron .",
    "preview": "electron .",
    "dev:web": "tsc -p tsconfig.node.json && concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --headless\"",
    "test": "playwright test",
    "test:mobile": "playwright test --project=mobile",
    "test:responsive": "playwright test --project=tablet --project=mobile",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ai": "7.0.94",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "lucide-react": "1.34.0",
    "motion": "13.2.0",
    "nanoid": "6.0.1",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "use-stick-to-bottom": "1.1.6",
    "xterm-addon-fit": "0.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "44.1.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true
  }
}
